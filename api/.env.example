API_BIND=127.0.0.1
API_PORT=8443
DB_PATH=/data/relaisdesk/licences.db
ADMIN_TOKEN=CHANGE_ME_WITH_A_VERY_LONG_RANDOM_TOKEN
SERVER_IP=api.relaisdesk.fr
RUSTDESK_RENDEZVOUS_PORT=21116
RUSTDESK_RELAY_PORT=21117
LOG_FILE=/var/log/relaisdesk/api.log

# --- AUTORISATION RÉSEAU DES FORKS RUSTDESK ---
# Clé privée Ed25519 distincte de la clé id_ed25519 de hbbs/hbbr.
NETWORK_AUTH_PRIVATE_KEY_FILE=/etc/relaisdesk/network-auth-ed25519
NETWORK_AUTH_KEY_ID=relaisdesk-1
NETWORK_TOKEN_TTL_SECONDS=300

# --- TLS / HTTPS ---
# En production avec certificat Let's Encrypt :
TLS_CERT=/opt/relaisdesk/certs/fullchain.pem
TLS_KEY=/opt/relaisdesk/certs/privkey.pem

# Pour les tests locaux UNIQUEMENT (sans certificat), décommenter la ligne suivante :
# DEV_HTTP=true

# --- PAIEMENT STRIPE ---
# Destination Workbench : https://api.relaisdesk.fr/api/v1/stripe/webhook
# Événement : checkout.session.completed
# Avec les essais : ajouter invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://relaisdesk.fr/?order=success
STRIPE_CANCEL_URL=https://relaisdesk.fr/?order=cancel

# --- ESSAI GRATUIT 30 JOURS / ABONNEMENT RÉCURRENT ---
# Activer uniquement après recette Stripe TEST et publication des pages OVH.
TRIALS_ENABLED=false
# Secret DISTINCT (32 octets aléatoires, base64url sans =). Ne pas publier.
# Sauvegarder : une rotation non migrée bloque l'attribution de nouveaux essais.
TRIAL_FINGERPRINT_KEY=

# --- ENVOI D'EMAILS SMTP (OVH, Brevo, etc.) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=contact@relaisdesk.fr
SMTP_PASS=mot_de_passe_smtp
SMTP_FROM=RelaisDesk <contact@relaisdesk.fr>
EMAIL_DOMAIN=relaisdesk.fr
# Sélecteur fourni lors de l'activation DKIM chez votre prestataire SMTP.
SMTP_DKIM_SELECTOR=REMPLACER_PAR_LE_SELECTEUR_DKIM
# Ce contrôle ne lance aucune surveillance DNS permanente dans l'API.
EMAIL_REQUIRE_DNS_AUTH=true

# --- COORDONNÉES VIREMENT BANCAIRE ---
BANK_IBAN=FR76 0000 0000 0000 0000 0000 000
BANK_BIC=BNPAFRPP
BANK_HOLDER=Informatique A Domicile 03 / RelaisDesk

# --- DISTRIBUTION DES TÉLÉCHARGEMENTS ---
DOWNLOADS_DIR=/opt/relaisdesk/downloads
# En préproduction : https://relaist.cluster129.hosting.ovh.net
# En production : https://relaisdesk.fr
PUBLIC_WEBSITE_URL=https://relaisdesk.fr

# Le manifeste signé est généré par installer/build.ps1. La clé privée reste
# hors du serveur web; seule sa clé publique Ed25519 base64url est déployée.
RELEASE_MANIFEST_PATH=/opt/relaisdesk/downloads/release-manifest.json
RELEASE_PUBLIC_KEY=CUTfRoGQb_JsE2Gz68d1uAnYmtQvzy_4iAUN9tRqoaI

# OBLIGATOIRE EN PRODUCTION (AGPLv3) : dépôts publics complets correspondant
# exactement aux versions client et serveur distribuées/exploitées. Remplacer
# ces commits immuables à chaque nouvelle version réellement déployée.
CLIENT_SOURCE_URL=https://github.com/JuLeXoGame/rustdesk/tree/c551990c69c95430442569d15b277fb61c6fe0e0
SERVER_SOURCE_URL=https://github.com/JuLeXoGame/rustdesk-server/tree/b78a574ccff6818eb36c42c8ade8e1463de53f07

# Obligatoire pour tout démarrage en production ; publier la même valeur dans
# les mentions légales et les CGV.
LEGAL_PHONE=06 62 85 59 30

# --- VENTES AUX CONSOMMATEURS (B2C) ---
# Laisser false tant que le médiateur n'est pas aussi publié dans les CGV.
# L'API refuse sinon les commandes B2C.
B2C_SALES_ENABLED=false
# Décision explicite d'ouverture malgré l'absence de médiateur. NE REND PAS
# l'activité conforme : avertissement au démarrage et information publique.
# Laisser false normalement ; ne jamais inventer un nom de médiateur.
B2C_MEDIATION_PENDING_ACKNOWLEDGED=false
CONSUMER_MEDIATOR_NAME=
CONSUMER_MEDIATOR_URL=
# Paiements des clients aux entreprises prestataires (distincts des abonnements).
# Activer seulement après recette des moteurs et configuration Stripe Connect.
SERVICE_PAYMENTS_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
