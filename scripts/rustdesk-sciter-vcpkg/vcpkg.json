{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "relaisdesk-rustdesk-sciter-dependencies",
  "version-string": "1",
  "builtin-baseline": "120deac3062162151622ca4860575a33844ba10b",
  "dependencies": [
    "aom",
    "libvpx",
    "libyuv",
    "opus",
    "mfx-dispatch",
    {
      "name": "ffmpeg",
      "features": ["amf", "nvcodec", "qsv"]
    }
  ],
  "overrides": [
    {
      "name": "ffnvcodec",
      "version": "12.1.14.0"
    },
    {
      "name": "amd-amf",
      "version": "1.4.35"
    }
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "../../rustdesk/res/vcpkg"
    ]
  }
}
