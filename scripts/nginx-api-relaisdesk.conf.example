# Oracle ne sert que l'API. Ne pas ajouter relaisdesk.fr ou www.relaisdesk.fr
# dans ce fichier : le site principal et son TLS restent chez OVH.
server {
    listen 80;
    listen [::]:80;
    server_name api.relaisdesk.fr;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.relaisdesk.fr;

    ssl_certificate /etc/letsencrypt/live/api.relaisdesk.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.relaisdesk.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:RelaisDeskTLS:10m;
    ssl_session_tickets off;
    server_tokens off;

    client_max_body_size 11m;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;

        # Le certificat de l'amont est émis pour api.relaisdesk.fr sur la boucle locale.
        proxy_ssl_server_name on;
        proxy_ssl_name api.relaisdesk.fr;
        proxy_ssl_verify off;

        # Remplacer les valeurs fournies par le client, ne jamais les concaténer.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
