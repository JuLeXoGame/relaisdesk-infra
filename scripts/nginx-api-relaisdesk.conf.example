# Oracle ne sert que l'API. Ne pas ajouter relaisdesk.fr ou www.relaisdesk.fr
# dans ce fichier : le site principal et son TLS restent chez OVH.
server {
    listen 80;
    listen [::]:80;
    server_name api.relaisdesk.fr;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.relaisdesk.fr;

    ssl_certificate /etc/letsencrypt/live/api.relaisdesk.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.relaisdesk.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:RelaisDeskTLS:10m;
    ssl_session_tickets off;
    server_tokens off;

    client_max_body_size 11m;

    # Ancien protocole RustDesk Pro (rustdesk/src/hbbs_http/sync.rs) : les
    # moteurs clients d'avant le 18 novembre 2026 postent /api/heartbeat toutes
    # les 15 s et /api/sysinfo toutes les 2 min. RelaisDesk ne l'implémente pas
    # (le heartbeat des postes est /api/v1/devices/heartbeat) : réponse vide
    # sans passer par l'API. Ne jamais répondre "SYSINFO_UPDATED" (le client se
    # croirait sur un serveur Pro).
    location = /api/heartbeat { return 204; }
    location = /api/sysinfo { return 204; }

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;

        # Le certificat de l'amont est émis pour api.relaisdesk.fr sur la boucle locale.
        proxy_ssl_server_name on;
        proxy_ssl_name api.relaisdesk.fr;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;

        # Remplacer les valeurs fournies par le client, ne jamais les concaténer.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
