BACKUP_DB_PATH=/data/relaisdesk/licences.db
BACKUP_DIR=/var/backups/relaisdesk
BACKUP_KEY_FILE=/etc/relaisdesk/backup.key
BACKUP_RETENTION_DAYS=30

# Facultatif : point de montage hors site appartenant à relaisdesk. Le profil
# systemd autorise ce chemin précis sans élargir les droits du service.
BACKUP_MIRROR_DIR=
# BACKUP_MIRROR_DIR=/mnt/relaisdesk-backups

# URL https de heartbeat (Better Stack), pingée après chaque sauvegarde
# entièrement vérifiée. Vide = heartbeat désactivé (aucune alerte en cas
# d'échec silencieux). Secret de type bearer : ne jamais publier ni
# versionner le fichier réel. Fichier 0600, propriétaire relaisdesk.
BACKUP_HEARTBEAT_URL=
