BACKUP_DB_PATH=/data/relaisdesk/licences.db
BACKUP_DIR=/var/backups/relaisdesk
BACKUP_KEY_FILE=/etc/relaisdesk/backup.key
BACKUP_RETENTION_DAYS=30

# Facultatif : point de montage hors site appartenant à relaisdesk. Le profil
# systemd autorise ce chemin précis sans élargir les droits du service.
BACKUP_MIRROR_DIR=
# BACKUP_MIRROR_DIR=/mnt/relaisdesk-backups
